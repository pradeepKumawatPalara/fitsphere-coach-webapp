# FitSphere Coach web app: local settings. Names only; no values are committed.
# Copy this file to .env (ignored by git) and fill in the values yourself.
# Vite builds every VITE_ value into the app in plain text: never put a secret here,
# and never the Supabase secret key (sb_secret_...) or the service_role key.
# See docs/adr/ADR-004-web-app-talks-only-to-api.md and docs/adr/ADR-022-auth-provider.md.

# development | staging | production
VITE_APP_ENV=

# Base URL of the shared Node.js API including the version, e.g. https://<api-host>/v1
# Use a stable URL (staging or a named tunnel). Quick tunnels change on every restart.
VITE_API_BASE_URL=

# Public domain for exercise thumbnails and other public images (Cloudflare R2, ADR-013).
VITE_MEDIA_PUBLIC_URL=

# Supabase Auth (ADR-022). Used for sign-in and session only, never for data queries (ADR-004).
# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase dashboard > Settings > API Keys > publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
